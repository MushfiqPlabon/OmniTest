# Database
DATABASE_URL=postgresql+asyncpg://omnitest:devpassword@localhost:5432/omnitest

# Security (JWT & Password Hashing)
SECRET_KEY=change-this-to-a-super-secret-random-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gemini API (Required for chat agent, tool calling, and embeddings)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_VERSION=v1
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Access & Demo Controls
CORS_ORIGINS=http://localhost:8501
ENABLE_DEMO_ACCOUNTS=true

# Environment & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0
